# Copy to `.env.production` and set your hosts. `.env.production` is gitignored
# (domain-specific). These are baked into the build by Vite.

# Public R2 custom domain serving the image bytes
VITE_IMG_BASE=https://img.example.com

# The feed, shipped as a static asset
VITE_FEED_URL=/feed.json

# Recommendation Worker URL (workers.dev or a custom route). Empty = recommendations off.
VITE_REC_URL=https://hematok-rec-api.<your-subdomain>.workers.dev
