# Hematok deploy credentials — copy this file to `.env` and paste your values.
# `.env` is gitignored. Revoke tokens after the deploy finishes.

# Cloudflare account id (Dashboard → any page → Account ID; not a secret, but kept out of git).
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>

# ── Token A: Cloudflare API token, permission "Zone → DNS → Edit" for your zone ──
# (My Profile → API Tokens → Create Token → "Edit zone DNS" template)
# Used to create the app-domain CNAME so it goes live. Also used by wrangler/build_embeddings.
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>

# ── Token B: R2 S3 API token (Storage & databases → R2 → Manage API tokens →
#    Create → Object Read & Write → your image bucket). It shows TWO values: ──
# Used by rclone (prep/upload_r2.sh) to upload images.
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
